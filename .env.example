# Copy to .env.local for local development.
# On Vercel: Project Settings > Environment Variables (Production).
# Never commit real values.

# ---------- Database (MongoDB Atlas) ----------
# Atlas > Database > Connect > Drivers. Include the database name before "?".
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/omnimart?retryWrites=true&w=majority

# ---------- Auth (NextAuth v5) ----------
# Random string, at least 32 characters: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
# Public URL of this app. Production: https://your-app.vercel.app
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Google login (optional). Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- App URL ----------
# Used for Stripe success/cancel redirects (no trailing slash). Production: https://your-app.vercel.app
NEXT_BASE_URL=http://localhost:3000

# ---------- Realtime (socket server on Render) ----------
# Public URL of the socket server, used by the BROWSER. Production: https://your-socket.onrender.com
# NEXT_PUBLIC_ values are built into the browser code: redeploy after changing it.
NEXT_PUBLIC_SOCKET_SERVER=http://localhost:4000
# Optional, server-only: URL this server uses to call the socket server (defaults to the one above)
SOCKET_SERVER_URL=
# Server-only shared secret. MUST equal SOCKET_SERVER_SECRET on Render. Never prefix with NEXT_PUBLIC_.
SOCKET_SERVER_SECRET=replace-with-a-long-random-string

# ---------- Image uploads (Cloudinary, needed for "Add Grocery") ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Server-only
CLOUDINARY_API_SECRET=

# ---------- Online payment (Stripe, optional) ----------
# Server-only. Without these, Cash on Delivery still works and "Pay Online" shows a friendly error.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook pointing to <app-url>/api/user/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
